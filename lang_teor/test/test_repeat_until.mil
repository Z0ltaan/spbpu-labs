BEGIN
  /*
    Тест 4: Repeat-Until (минимум 1 итерация)
    Ожидается: 1 2 3 4 5
  */
  k := 1;
  repeat
    write(k);
    k := k + 1
  until k > 5;
  
  /*
    Тест 5: Repeat-Until с ложным условием с самого начала
    Ожидается: выполнится 1 раз, напечатает 100
  */
  m := 100;
  repeat
    write(m)
  until m < 200
END
