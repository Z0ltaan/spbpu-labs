  BEGIN
  /* 
    Тест 1: Классический for с положительным шагом
    Ожидается: сумма чисел от 1 до 5 = 15
  */
  sum := 0;
  for i := 1 to 5 step 1 do
    sum := sum + i
  od;
  write(sum);
  
  /*
    Тест 2: Классический for с отрицательным шагом
    Ожидается: 5 4 3 2 1
  */
  for i := 5 to 1 step -1 do
    write(i)
  od

END
